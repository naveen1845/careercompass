# Career Compass - Environment Variables Configuration
# Copy this file to .env or export these variables in your terminal/IDE run configuration

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=career_compass
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Full JDBC URL (Alternative)
DB_URL=jdbc:mysql://localhost:3306/career_compass?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
